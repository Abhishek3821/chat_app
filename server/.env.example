# ═══════════════════════════════════════════════════════════════════════════
#  ChatKonect — BACKEND environment
# ═══════════════════════════════════════════════════════════════════════════
#  Copy to `server/.env` and fill in. That file is gitignored; THIS one is
#  committed, so it must never contain a real credential.
#
#  Every variable below is actually read by the code. Regenerate the list with
#  `node tests/list-env.mjs`, and `node tests/deploy-readiness.mjs` fails if the
#  two ever drift apart — a variable the code reads but nobody documented is a
#  deploy that boots and then breaks at the first request that needs it.
#
#  ── Legend ──────────────────────────────────────────────────────────────
#   [REQUIRED]  the server will not work correctly without it
#   [optional]  a sensible default applies; set it to change behaviour
#   [feature]   unset = that feature is simply off
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  1. Core
# ───────────────────────────────────────────────────────────────────────────

# [optional] Port to listen on. Hosts (Render/Railway/Heroku) inject their own.
PORT=5000

# [optional] `production` enables the strict CORS allowlist, hides stack traces
# and turns on the weak-secret boot guard. Set by your host; leave unset locally.
NODE_ENV=development

# [REQUIRED] MongoDB connection string, INCLUDING the database name.
# The test suites derive their own isolated database by rewriting that name, so
# a URI with no database in the path will make them refuse to run.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/chatkonect?appName=Cluster0

# [optional] Resolvers used for the Atlas SRV lookup. The default covers the
# common case where a local/corporate resolver cannot do SRV records and the
# connection fails with `querySrv ECONNREFUSED`.
DNS_SERVERS=8.8.8.8,1.1.1.1

# [REQUIRED] Where the FRONTEND is served from. This does two jobs, and getting
# it wrong breaks both in ways that look unrelated:
#   • it is the CORS + Socket.IO origin allowlist — a deployed frontend on any
#     other origin is rejected on both the API and the websocket handshake;
#   • it builds the join links in meeting-invitation emails, so a stale value
#     mails everyone a link that works for nobody.
CLIENT_URL=http://localhost:5290

# [optional] Extra origins allowed alongside CLIENT_URL. Comma-separated.
# Useful for a staging frontend or a second domain.
EXTRA_CORS_ORIGINS=


# ───────────────────────────────────────────────────────────────────────────
#  2. Authentication
# ───────────────────────────────────────────────────────────────────────────

# [REQUIRED] Signs access tokens, refresh tokens and media tokens. Use a long
# random string — generate one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every existing session, which is exactly what you want
# if it has ever leaked.
JWT_SECRET=

# [optional] Access-token lifetime. Short on purpose: the refresh cookie renews
# it silently, so a stolen access token expires quickly.
JWT_ACCESS_EXPIRES=1h

# [optional] Absolute lifetime of a refresh session, in days.
REFRESH_TOKEN_DAYS=30

# [optional] Idle timeout, in days. A session unused for this long is dead even
# if it has not hit REFRESH_TOKEN_DAYS.
SESSION_IDLE_DAYS=14

# [optional] `true` requires a verified email before login. Leave false unless
# email is configured — the server warns at boot if you enable it without a
# working mailer, because nobody would be able to complete signup.
ENABLE_EMAIL_VERIFICATION=false


# ───────────────────────────────────────────────────────────────────────────
#  3. Super admin  —  provisioned from here on EVERY boot
# ───────────────────────────────────────────────────────────────────────────
#  Signup only ever creates a plain user, so a fresh database would otherwise
#  have no admin and no way in. These are reconciled at startup instead.
#
#  THIS FILE WINS, including the password. Two consequences that follow from
#  that and are not bugs:
#    • a password changed in Settings is reverted on the next restart — and on a
#      hosted deploy, every deploy is a restart;
#    • a genuine change signs the admin out of every device (correct for a
#      credential rotation).
#  Exactly ONE account may hold `role: 'admin'`; anyone else found holding it is
#  demoted on boot.
#
#  Leave SUPER_ADMIN_EMAIL blank to skip this entirely and manage the admin by
#  hand with `node utils/createAdmin.js <email> <password>`.

# [feature] Login email for the super admin.
SUPER_ADMIN_EMAIL=

# [feature] At least 8 characters. Without it, no admin is created and the
# server says so at boot rather than failing silently.
SUPER_ADMIN_PASSWORD=

# [optional] Display name. Defaults to "Super Admin".
SUPER_ADMIN_NAME=


# ───────────────────────────────────────────────────────────────────────────
#  4. Email  —  OTP codes, password resets, meeting invitations
# ───────────────────────────────────────────────────────────────────────────
#  Unset = the app still runs; emails are logged to the console instead of sent,
#  and OTPs are returned in the API response in development so you can test.
#
#  Two ways to send, checked in this order:
#    1. BREVO_API_KEY  — an HTTP API. Preferred on hosts that block outbound
#       SMTP ports (Render's free tier does), which is the usual reason "email
#       silently does not work in production".
#    2. SMTP           — EMAIL_* or SMTP_* (both spellings are accepted because
#       people mix them; EMAIL_* wins if both are set).

# [feature] Brevo (formerly Sendinblue) HTTP API key. Takes priority over SMTP.
BREVO_API_KEY=

# [feature] SMTP transport. All three of HOST/USER/PASS are needed for it to be
# considered configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# [optional] Alternative spelling of the four above. Only read when the EMAIL_*
# equivalent is unset.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# [optional] From address. Accepts `Name <address>` or a bare address.
EMAIL_FROM=ChatKonect <no-reply@chatkonect.app>


# ───────────────────────────────────────────────────────────────────────────
#  5. File storage  —  avatars, images, documents, voice notes
# ───────────────────────────────────────────────────────────────────────────

# [optional] `local` (default) writes to server/uploads/ — fine for development,
# but on a host with an ephemeral filesystem every upload disappears on the next
# deploy. Use `cloudinary` for anything you intend to keep.
STORAGE_DRIVER=local

# [feature] Cloudinary. Either the single URL form or the three separate values.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ───────────────────────────────────────────────────────────────────────────
#  6. Web push  —  notifications when the tab is closed
# ───────────────────────────────────────────────────────────────────────────
#  Unset = in-app notifications still work; only background push is off.
#  Generate a key pair with:  npx web-push generate-vapid-keys

# [feature] VAPID keys. Both are required for push to work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# [optional] Contact address browsers' push services can reach you at.
VAPID_SUBJECT=mailto:support@chatkonect.app


# ───────────────────────────────────────────────────────────────────────────
#  7. SMS  —  optional phone verification
# ───────────────────────────────────────────────────────────────────────────

# [feature] Twilio. All three are needed; unset = SMS is skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=


# ───────────────────────────────────────────────────────────────────────────
#  8. Scaling
# ───────────────────────────────────────────────────────────────────────────

# [feature] Redis. Unset = the app runs single-instance: Socket.IO keeps its
# rooms in memory and background jobs run inline. REQUIRED before running more
# than one server instance, or users on different instances stop seeing each
# other's messages.
REDIS_URL=

# [feature] LiveKit SFU — media transport for LARGE meetings. Unset = meetings
# use the in-browser full mesh, which is fine to about six people and degrades
# past that (every participant uploads one video stream PER other participant).
# With an SFU each device sends ONE stream and the server fans it out, so rooms
# of 15–20 become possible. All three are required; the client switches
# automatically. See docs/SCALING_CALLS.md.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ───────────────────────────────────────────────────────────────────────────
#  9. Development only
# ───────────────────────────────────────────────────────────────────────────

# [optional] `yes` lets `npm run seed` run without the interactive confirmation.
# The seed script is DESTRUCTIVE — it deletes every user, chat and message and
# replaces them with demo data. Never set this on a real deployment.
SEED_CONFIRM=
