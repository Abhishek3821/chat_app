
# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5290

# MongoDB (Atlas SRV string — include the /chatconnect database name)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/chatconnect?appName=Cluster0

# ── The single super admin (REQUIRED for a usable fresh database) ──
# Reconciled on every boot by utils/superAdmin.js:
#   • no account with this email  → created as role:'admin' (needs the password)
#   • account exists              → promoted / re-activated
#   • any OTHER role:'admin'      → demoted to 'user' (exactly one is allowed)
# Point MONGO_URI at an empty database and you get an admin automatically —
# without this there is no way in, since signup only ever creates a plain user.
#
# THIS FILE IS AUTHORITATIVE, password included: change SUPER_ADMIN_PASSWORD,
# restart, and that is the login. A real change signs the admin out everywhere
# (tokenVersion bump); an unchanged one is a no-op, so restarts don't churn
# sessions. A password changed in the Settings UI is reverted on next restart.
# Blank / under 8 chars = "unspecified", never "reset" — a cleared line can't
# lock you out.
SUPER_ADMIN_EMAIL=admin@chatkonect.app
SUPER_ADMIN_PASSWORD=change_this_to_a_strong_password
SUPER_ADMIN_NAME=Super Admin

# JWT / sessions
JWT_SECRET=change_this_to_a_long_random_string
# NOTE — variables that look real but are NOT read by any code. Setting them
# has no effect; delete them from your .env so nobody trusts them:
#   JWT_EXPIRES_IN, JWT_COOKIE_EXPIRES_DAYS  leftovers from the pre-refresh-token
#     design. Cookie lifetimes come from the access TTL below + REFRESH_TOKEN_DAYS.
#   ENABLE_LOGIN_OTP                         there is no login-OTP feature in the
#     server at all (no code path reads this, and no second-factor-at-login flow
#     exists). Email OTP at SIGNUP is ENABLE_EMAIL_VERIFICATION, below; the
#     separate "two-step PIN" that locks the app/chats is per-user, set in the
#     app UI under Settings → Privacy, and has no env var.
# Short-lived ACCESS token TTL — a rotating refresh cookie mints new ones via
# POST /api/auth/refresh, and every request re-validates the tracked session so
# revocation (logout / "log out other devices") is immediate.
JWT_ACCESS_EXPIRES=1h
# Session lifetimes (days): absolute cap (refresh-token max age) + idle timeout.
REFRESH_TOKEN_DAYS=30
SESSION_IDLE_DAYS=14

# Email — used for OTP / verification / password reset.
# Leave blank for local dev: codes print to the server console AND are returned
# in the API response (development only) so signup is testable without SMTP.
# SMTP_* names are accepted as aliases for EMAIL_* (HOST/PORT/USER/PASS).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="ChatKonect <no-reply@chatkonect.app>"
# Exact aliases, read by utils/sendEmail.js as `EMAIL_HOST || SMTP_HOST` etc.
# Use EITHER set, not both — if both are present the EMAIL_* value wins, which
# is a confusing way to find out your SMTP_* edit did nothing.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# HTTPS email (Brevo) — takes priority over SMTP when set. REQUIRED on hosts
# that block outbound SMTP ports (e.g. Render's FREE plan blocks 25/465/587).
# Free at brevo.com → SMTP & API → API keys. Verify your sender address there.
BREVO_API_KEY=

# File storage: "local" | "cloudinary"
STORAGE_DRIVER=local

# Cloudinary (only if STORAGE_DRIVER=cloudinary). Either set CLOUDINARY_URL, or
# the three split vars below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Horizontal scaling (ALL OPTIONAL) ────────────────────────────
# Set REDIS_URL to run more than one backend instance behind a load balancer.
# It turns on: the Socket.IO Redis adapter (cross-instance message/presence
# fan-out), a shared rate-limit store, response caching, and a BullMQ worker
# for notification/push fan-out. Leave blank → single-instance, in-memory,
# inline jobs (identical behaviour, no extra infra needed).
REDIS_URL=

# ── Meetings SFU (OPTIONAL — LiveKit) ────────────────────────────
# Set all three to route meeting MEDIA through a LiveKit server so rooms scale
# past the ~6-person mesh ceiling. Free tier at livekit.io (LiveKit Cloud) gives
# you the wss URL + API key/secret. Unset → meetings use the peer-to-peer mesh.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Web Push notifications (OPTIONAL) ────────────────────────────
# Generate a keypair once with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave blank → push is disabled gracefully (in-app + socket notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@chatkonect.app

# Optional: force Node to use specific DNS servers (helps when a corporate
# network refuses MongoDB SRV lookups). Defaults to 8.8.8.8,1.1.1.1.
DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional: extra comma-separated allowed CORS origins (in addition to CLIENT_URL)
EXTRA_CORS_ORIGINS=

# ── SMS via Twilio (OPTIONAL) ─────────────────────────────────────
# All three are required together for SMS to be enabled; leave blank and SMS
# sending is skipped gracefully (utils/sendSms.js → smsConfigured() === false).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Feature flags
# When true, signup sends a 6-digit OTP to verify the email before login.
# If EMAIL_* is not configured, the OTP is printed to the server console AND
# returned in the API response in development so you can still test.
# ⚠ If you turn this ON in production you MUST have working email (BREVO_API_KEY
# on Render's free plan — see the note above), or nobody can finish signing up.
ENABLE_EMAIL_VERIFICATION=true

# ── Destructive dev tooling ───────────────────────────────────────
# `npm run seed` DELETES every user/chat/message and reinstalls demo data. It
# refuses to run when NODE_ENV=production, and otherwise requires an explicit
# confirmation — either SEED_CONFIRM=yes here or a --yes flag on the command.
# Leave this UNSET. Setting it to `yes` permanently arms a data-wiping script
# against whatever database MONGO_URI happens to point at.
SEED_CONFIRM=
