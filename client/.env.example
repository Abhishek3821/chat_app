# ═══════════════════════════════════════════════════════════════════════════
#  ChatKonect — FRONTEND environment
# ═══════════════════════════════════════════════════════════════════════════
#  Every variable here is PUBLIC. Vite bakes them into the JavaScript bundle at
#  build time, so anyone can read them in devtools. Never put a secret in this
#  file or in any VITE_* variable — real secrets live only in the backend
#  (server/.env locally, or your host's dashboard in production).
#
#  Only names starting with VITE_ are exposed to the app; anything else is
#  ignored. Regenerate this list with `cd server && node tests/list-env.mjs
#  --client`.
#
#  ── WHICH FILE WINS ─────────────────────────────────────────────────────
#  Vite loads `.env` first, then `.env.<mode>` on top — and `npm run build`
#  runs in mode=production. So `.env.production` (committed) OVERRIDES your
#  local `.env` (not committed).
#
#  The trap: a value set ONLY in your local `.env` works in your own build and
#  is silently MISSING from a CI or Vercel build, because that machine has no
#  `.env`. TURN is the one that bites — calls work on your machine and fail for
#  everyone else. Put anything production needs in `.env.production` or in the
#  host's dashboard.
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  1. Backend location
# ───────────────────────────────────────────────────────────────────────────

# Base URL of the API.
#   blank                      → '/api' — the Vite dev proxy forwards to :5000.
#                                Recommended for local development.
#   https://host.com           → '/api' is appended for you
#   https://host.com/api       → used as-is
# Both forms work: the client normalises it, which prevents the classic
# production failure where the bare origin is set and every request 404s with
# "Route not found: /auth/login".
VITE_API_URL=

# Socket.IO server. NOTE: no `/api` suffix — this is an origin.
#   blank → derived from VITE_API_URL, or same-origin in production. In dev the
#           client connects straight to :5000 rather than through the Vite proxy,
#           because proxying the websocket upgrade is flaky.
VITE_SOCKET_URL=

# `true` runs the UI against built-in demo data with no backend at all — useful
# for previewing the interface. Must be `false` to talk to a real server.
VITE_DEMO_MODE=false


# ───────────────────────────────────────────────────────────────────────────
#  2. TURN relay  —  REQUIRED for calls that work outside your own network
# ───────────────────────────────────────────────────────────────────────────
#  Without TURN, calls between people on different networks (mobile ↔ wifi,
#  strict NATs, most corporate connections) will RING, CONNECT, and then have no
#  media — the picture never appears and the call drops. On the same wifi it all
#  looks fine, which is exactly what makes this so confusing to diagnose: the
#  signalling is correct, only the media path cannot form.
#
#  This applies to 1:1 calls, group calls AND meetings. Enabling the LiveKit SFU
#  on the backend does NOT remove the need for it.
#
#  Free option: https://www.metered.ca/stun-turn (500 MB/month). Then either
#  paste the static credentials below, or use the credentials URL, which is safer
#  because nothing static ends up in the public bundle.

# Comma-separated TURN URIs. Include a TCP/443 entry — it is what gets through
# restrictive firewalls that block UDP.
#   e.g. turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443,turns:a.relay.metered.ca:443?transport=tcp
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Preferred alternative to the three above: an endpoint returning time-limited
# credentials, so no long-lived secret is shipped in the bundle.
#   e.g. https://<your-app>.metered.live/api/v1/turn/credentials?apiKey=<key>
VITE_TURN_CREDENTIALS_URL=
