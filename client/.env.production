# ChatKonect — PRODUCTION build values (used by `vite build` / npm run build).
# These are baked into client/dist. Point them at your deployed backend.
#
# Vercel dashboard variables OVERRIDE this file, which is why the live site kept
# working while these pointed at a backend that no longer answers. A local
# `npm run build` has no such safety net — it bakes in whatever is here.
VITE_API_URL=https://api.chatkonect.com
VITE_SOCKET_URL=https://api.chatkonect.com
VITE_DEMO_MODE=false
# TURN relay: do NOT set the VITE_TURN_* vars here. They are baked into the
# bundle and world-readable, and setting them OVERRIDES the server path. The
# client fetches time-limited credentials from GET /api/v1/ice instead — so the
# relay is configured once on the API (TURN_URL / TURN_SECRET, or the Cloudflare
# pair) and every surface gets it. See deploy/turn/README.md.
