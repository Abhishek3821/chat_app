###############################################################################
#  ChatKonect — the one environment reference
###############################################################################
#
#  Every variable the code actually reads, in one file. `deploy-readiness.mjs`
#  asserts that: a key read by the code and missing here fails CI, and a key
#  here that nothing reads is reported as dead. So this cannot quietly drift.
#
#  ┌─ HOW TO USE ──────────────────────────────────────────────────────────┐
#  │  cp .env.example server/.env      then fill in PART 1                 │
#  │  cp .env.example client/.env      then keep only PART 5 (VITE_*)      │
#  └───────────────────────────────────────────────────────────────────────┘
#
#  PART 1  MUST FILL — nothing works until these are set
#  PART 2  FILL TO TURN A FEATURE ON — each one is off until you do
#  PART 3  SAFE DEFAULTS — change only if you have a reason
#  PART 4  SET BY THE PLATFORM — leave blank
#  PART 5  CLIENT (VITE_*) — PUBLIC, goes in client/.env, never a secret
#
#  Markers, so you can grep:
#     [FILL]  you must provide a value
#     [OPT]   optional; the feature is simply off without it
#     [AUTO]  the host sets it; leave blank
#
#  🔴 = a real secret. Never commit it, never log it, never put it behind a
#       VITE_ prefix. Rotate it if it is ever exposed.
#
#  Full reference with defaults and code locations: docs/ENVIRONMENT.md
#
###############################################################################


###############################################################################
#  PART 1 — MUST FILL
###############################################################################

# ── Database ─────────────────────────────────────────────────────────────
# [FILL] 🔴 MongoDB connection string. The database NAME must stay
# `chatconnect` — the deployed data lives there, and renaming it points the app
# at an empty database rather than migrating anything.
#   mongodb+srv://user:password@cluster.mongodb.net/chatconnect?retryWrites=true&w=majority
MONGO_URI=

# ── Auth ─────────────────────────────────────────────────────────────────
# [FILL] 🔴 Signs access and refresh tokens. Generate, do not invent:
#   openssl rand -hex 48
# Production REFUSES TO BOOT with a missing or weak value — that check is there
# because a guessable signing key is a total auth bypass, not a warning. Changing
# it logs everyone out, which is also how you revoke every session at once.
JWT_SECRET=

# ── Where the frontend lives ─────────────────────────────────────────────
# [FILL] Origin of the deployed client, no trailing slash. Used for the CORS
# allowlist, and for the links inside verification and invite emails. Wrong value
# here = the API rejects your own frontend, which presents as every request
# failing for no visible reason.
#   https://chatkonect.com
CLIENT_URL=

# ── The single super admin ───────────────────────────────────────────────
# [FILL] Auto-provisioned on EVERY boot, and this file is authoritative: the
# account is created if missing, promoted if it exists, and its password is reset
# to match. Any OTHER admin is demoted, so there is exactly one. That means
# losing this file does not lock you out — but changing the password here changes
# it for real, and bumps tokenVersion so existing sessions are dropped.
SUPER_ADMIN_EMAIL=
# [FILL] 🔴
SUPER_ADMIN_PASSWORD=
# [OPT] Display name. Defaults to "Super Admin".
SUPER_ADMIN_NAME=


###############################################################################
#  PART 2 — FILL TO TURN A FEATURE ON
###############################################################################

# ═════════════════════════════════════════════════════════════════════════
#  CALLS ACROSS DIFFERENT NETWORKS  (a TURN relay)
# ═════════════════════════════════════════════════════════════════════════
# Read this even if you skip everything else in PART 2.
#
# Calls are peer-to-peer. With no relay they work on the same wifi and fail
# between two strict NATs — mobile data, office networks, two different cities.
# Those calls ring, both sides accept, and then there is no audio or video and it
# drops. Chat is unaffected, which is exactly why it reads as a bug in the app
# instead of a missing setting.
#
# Either provider below works, and they are ADDITIVE: set both and your own
# relays are tried first with the managed one as fallback. `GET /api/v1/ice`
# mints short-lived credentials for every surface — 1:1 calls, group calls,
# meetings and the embed — so this is configured once, here.
#
# Verify before trusting a call:  node deploy/turn/check-relay.mjs --env
# Setup guide:                    deploy/turn/README.md

# ── Option A: Cloudflare TURN (managed, no box to run) ───────────────────
# Cloudflare dashboard → Realtime → TURN keys. Boot verifies these with one real
# API call and says so, rather than leaving the first caller to discover a typo.
# [OPT]
CLOUDFLARE_TURN_KEY_ID=
# [OPT] 🔴 Account-level. Exchanged server-side for expiring credentials; never
# reaches a browser. Anyone holding it can spend your relay bandwidth.
CLOUDFLARE_TURN_API_TOKEN=

# ── Option B: your own coturn ────────────────────────────────────────────
# One command per box: deploy/turn/install-coturn.sh
#
# [OPT] One or more relays. `,` separates URLs within ONE relay; `|` separates
# relays. Max 6. Order is preserved and the browser tries them in order, so put
# the relay nearest most of your users first.
#   one relay:  turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
#   a network:  turn:in.example.com:3478 | turn:eu.example.com:3478
TURN_URL=
# [OPT] 🔴 coturn's `static-auth-secret`. One value covers every relay, or supply
# one per relay separated by `|` — matched positionally. A relay with no matching
# secret is DROPPED and warned about at boot rather than signed with the wrong
# one, because a credential the relay rejects burns ICE time and then fails,
# which looks identical to an outage.
TURN_SECRET=

# ═════════════════════════════════════════════════════════════════════════
#  MEDIA STORAGE
# ═════════════════════════════════════════════════════════════════════════
# [OPT] `local` (default) or `cloudinary`. REQUIRED to be cloudinary in
# production on any host with an ephemeral disk: avatars, attachments and status
# media written locally are wiped on every deploy or restart, and are invisible
# to a second instance.
STORAGE_DRIVER=
# [OPT] 🔴 One value that carries all three credentials — the simplest form:
#   cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=
# [OPT] The same thing spelled out, if you prefer three variables. Ignored when
# CLOUDINARY_URL is set.
CLOUDINARY_CLOUD_NAME=
# [OPT] 🔴
CLOUDINARY_API_KEY=
# [OPT] 🔴
CLOUDINARY_API_SECRET=

# ═════════════════════════════════════════════════════════════════════════
#  EMAIL  (verification codes, invites, PIN reset)
# ═════════════════════════════════════════════════════════════════════════
# Two transports. BREVO_API_KEY takes priority when set, and is the one that
# works on hosts that block outbound SMTP ports (25/465/587) — most free tiers
# do, so SMTP there can never work no matter how correct the settings are.
#
# [OPT] 🔴 HTTPS email. Works anywhere outbound 443 works.
BREVO_API_KEY=
# [OPT] SMTP host, e.g. smtp.gmail.com
EMAIL_HOST=
# [OPT] 587 for STARTTLS, 465 for implicit TLS.
EMAIL_PORT=
# [OPT] The full mailbox address.
EMAIL_USER=
# [OPT] 🔴 For Gmail this must be an App Password, not the account password.
EMAIL_PASS=
# [OPT] Display name only is fine — the code binds it to the authenticated
# mailbox, because relays reject a From that is not on the account's domain.
EMAIL_FROM=
# [OPT] Aliases for the four EMAIL_* above, if your host provides SMTP_*
# naming. Either set works; EMAIL_* is checked first.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
# [OPT] 🔴
SMTP_PASS=

# ═════════════════════════════════════════════════════════════════════════
#  WEB PUSH  (notifications while the app is closed)
# ═════════════════════════════════════════════════════════════════════════
# Generate the pair once:  npx web-push generate-vapid-keys
# All three are needed or push is off.
# [OPT]
VAPID_PUBLIC_KEY=
# [OPT] 🔴
VAPID_PRIVATE_KEY=
# [OPT] A real, monitored contact — push services may use it to reach you about
# your own traffic.
#   mailto:you@example.com
VAPID_SUBJECT=

# ═════════════════════════════════════════════════════════════════════════
#  SMS  (phone verification)
# ═════════════════════════════════════════════════════════════════════════
# [OPT]
TWILIO_ACCOUNT_SID=
# [OPT] 🔴
TWILIO_AUTH_TOKEN=
# [OPT] The sending number, E.164 format: +15551234567
TWILIO_FROM=

# ═════════════════════════════════════════════════════════════════════════
#  LIVEKIT SFU  (meetings larger than the peer-to-peer mesh)
# ═════════════════════════════════════════════════════════════════════════
# All three or nothing. When set, meeting MEDIA routes through the SFU: each
# participant sends one upstream instead of one per peer, which is what lets a
# room pass the ~6-person mesh ceiling. Chat, reactions, hand-raise and
# attendance still ride the app's own socket room, so only transport changes.
# Unset → the whole module is a no-op and meetings use the mesh.
#
# This does NOT replace TURN. An SFU changes the fan-out; a relay is still what
# gets media out of a strict NAT.
# [OPT]
LIVEKIT_URL=
# [OPT] 🔴
LIVEKIT_API_KEY=
# [OPT] 🔴 Signs 3-hour room-join tokens.
LIVEKIT_API_SECRET=

# ═════════════════════════════════════════════════════════════════════════
#  HORIZONTAL SCALING
# ═════════════════════════════════════════════════════════════════════════
# [OPT] 🔴 The single switch that unlocks running more than one instance. It
# turns on, together: the Socket.IO Redis adapter (so messages and presence
# reach users connected to another instance), a shared rate-limit store, the
# response cache, the shared Cloudflare TURN credential, and a BullMQ worker for
# push fan-out. Unset → in-memory everything, identical behaviour, one instance.
#
# Running more than one instance needs REDIS_URL *and* STORAGE_DRIVER=cloudinary,
# or uploads land on one instance's disk and 404 from the others.
# Usually embeds a password.
REDIS_URL=

# ═════════════════════════════════════════════════════════════════════════
#  EMBEDDING  (the drop-in widget on a partner's site)
# ═════════════════════════════════════════════════════════════════════════
# [OPT] Public origin of THIS API, no trailing slash. The embed loader hands it
# to the host page; a wrong value makes a host page frame a 404.
API_PUBLIC_URL=
# [OPT] Public origin serving the /embed route — normally the same as
# CLIENT_URL. Blank means this deployment has no embeddable frontend, and the
# loader says so instead of framing nothing.
EMBED_URL=


###############################################################################
#  PART 3 — SAFE DEFAULTS
###############################################################################

# ── Token and session lifetimes ──────────────────────────────────────────
# [OPT] Access-token lifetime. Default 1h. Short on purpose: revocation is
# checked per request against the session registry, but a stolen token is valid
# until it expires.
JWT_ACCESS_EXPIRES=
# [OPT] Refresh-token lifetime in days. Default 30.
REFRESH_TOKEN_DAYS=
# [OPT] Days of inactivity before a session is dropped even if the refresh token
# is still valid. Default 30.
SESSION_IDLE_DAYS=

# ── Feature flags ────────────────────────────────────────────────────────
# [OPT] `true` requires a verified email OTP before signup completes, and blocks
# login for unverified accounts. Compared as the exact string "true"; anything
# else is off. Turning it on with no working mail transport errors at boot in
# production, because it would otherwise lock out every new user silently.
ENABLE_EMAIL_VERIFICATION=
# [OPT] Peer-to-peer participant ceiling for meetings. Default 6. Above this a
# room needs the SFU — raising the number does not add capacity, it just moves
# where it falls over.
MESH_MAX_PARTICIPANTS=
# [OPT] Extra allowed CORS origins beyond CLIENT_URL, comma-separated. For a
# staging frontend against production, or a second domain.
EXTRA_CORS_ORIGINS=
# [OPT] Override DNS resolvers for the Mongo SRV lookup, comma-separated. Only
# needed where the host's resolver cannot resolve SRV records — a real failure on
# some networks, and it presents as the database being unreachable.
#   8.8.8.8,1.1.1.1
DNS_SERVERS=

# ── Destructive, and off by default ──────────────────────────────────────
# [OPT] Must equal the exact string "yes" for the seed script to wipe and
# reseed. Not a secret; it is a guard against running it by accident.
SEED_CONFIRM=

# ── Test seam ────────────────────────────────────────────────────────────
# [OPT] Overrides the Cloudflare TURN API base URL. Used by tests/turn-relay.mjs
# to point at a local stand-in so the credential exchange can be asserted
# without a real account. Leave blank in every real deployment.
CLOUDFLARE_TURN_API_BASE=


###############################################################################
#  PART 4 — SET BY THE PLATFORM
###############################################################################
# Leave these blank. They are here so the list is complete, not so you fill them.

# [AUTO] `production` on a real deploy. Drives cookie flags, error verbosity,
# and the weak-JWT_SECRET refusal.
NODE_ENV=
# [AUTO] Listen port. Defaults to 5000; every host injects its own.
PORT=
# [AUTO] Commit shown by GET /api/health, so you can tell what is actually
# running. Each host injects whichever one it uses; the code reads all four.
GIT_COMMIT=
RENDER_GIT_COMMIT=
SOURCE_VERSION=
VERCEL_GIT_COMMIT_SHA=


###############################################################################
#  PART 5 — CLIENT (VITE_*)  →  client/.env
###############################################################################
#
#  ⚠ EVERY VITE_ VARIABLE IS BAKED INTO THE JAVASCRIPT AND WORLD-READABLE.
#    Anyone can read them in devtools. Never put a secret behind this prefix —
#    not an API key, not a password, not a TURN credential you care about.
#
#  Local development needs none of this: client/.env.development leaves the URLs
#  blank on purpose, which routes through the Vite dev proxy to your own backend
#  on :5000 and keeps `npm run dev` off the production API.
#
#  In production these usually come from the host's dashboard (Vercel), which
#  overrides any file. Set them in a local client/.env only for a local build.

# [OPT] API origin, no trailing slash. Blank is correct for local dev (the proxy
# handles it) and for Vercel (the dashboard supplies it). Required only if you
# build for production LOCALLY.
#   https://api.chatkonect.com
VITE_API_URL=
# [OPT] Socket.IO origin — normally the same value, same rules.
VITE_SOCKET_URL=
# [OPT] `true` explores the UI with built-in demo data and no backend.
VITE_DEMO_MODE=false

# ── TURN, the old build-time path — prefer leaving these blank ───────────
# Setting VITE_TURN_URL OVERRIDES the server path entirely, and a static
# credential shipped in a bundle is readable by anyone and usable to relay
# traffic on your bill. The server path (TURN_URL / CLOUDFLARE_TURN_* in PART 2)
# hands out expiring credentials instead, and covers the embed and partner
# frontends too. These four exist for a quick test and for backwards
# compatibility.
# [OPT] Comma-separated TURN URLs.
VITE_TURN_URL=
# [OPT]
VITE_TURN_USERNAME=
# [OPT] Visible in the bundle by construction.
VITE_TURN_CREDENTIAL=
# [OPT] Endpoint returning time-limited credentials. Only consulted when
# VITE_TURN_URL is absent.
VITE_TURN_CREDENTIALS_URL=
