# Dependencies
node_modules/
*/node_modules/

# Env — never commit real secrets.
#
# The ONLY committed env file is ./.env.example — every variable the code reads,
# with no values. deploy-readiness.mjs fails CI if it drifts from the source.
#
# Server env files ALWAYS hold secrets, so every variant there is ignored (a
# future server/.env.production must not slip in). client/.env.development is
# committed deliberately: blank URLs, which is what keeps `npm run dev` pointed
# at the local backend instead of production.
.env
.env.local
*/.env
*/.env.local
server/.env.*

# Build output
client/dist/
client/.vite/

# Uploads (local storage driver)
server/uploads/*
!server/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.vscode/
.idea/
Thumbs.db
